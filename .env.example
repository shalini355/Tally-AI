GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# Minimum seconds between real requests for each provider. Keep Mistral at 2+ for free-tier use.
MISTRAL_MIN_REQUEST_INTERVAL_SECONDS=2
DATABASE_URL=postgresql+psycopg://tally:tally@localhost:5432/tally
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=your-private-bucket-name
AWS_REGION=ap-south-1